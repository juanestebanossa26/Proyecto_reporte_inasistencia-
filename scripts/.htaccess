# Bloquea el acceso web directo a scripts de migración y lanzadores locales.
# cron_inasistencias.php conserva acceso controlado mediante token en capa PHP cuando CRON_SECRET_TOKEN está configurado en .env.

<Files "ejecutar_migracion_ciclo_vida.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

<FilesMatch "\.(bat|sh|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

