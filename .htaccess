# ----------------------------------------------------------------------
# Configuración de Seguridad y Servidor Apache
# ----------------------------------------------------------------------

# Evitar el listado de archivos en los directorios
Options -Indexes

# Página de inicio predeterminada
DirectoryIndex index.php

# ----------------------------------------------------------------------
# Protección de archivos confidenciales (.env, .git, etc.)
# ----------------------------------------------------------------------
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^(composer\.(json|lock)|\.gitignore|README\.md|perfiles\.txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ----------------------------------------------------------------------
# Variables de Entorno para la Base de Datos (Apache mod_env)
# ----------------------------------------------------------------------
<IfModule mod_env.c>
    SetEnv DB_HOST "localhost"
    SetEnv DB_NAME "control_asistencia"
    SetEnv DB_USER "root"
    SetEnv DB_PASS ""
    SetEnv DB_CHARSET "utf8mb4"
</IfModule>
